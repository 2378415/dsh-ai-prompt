{
  "name": "dsh-ai-prompt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Context-aware prompt refinement and turn undo for DeepSeek Harness.",
  "license": "MIT",
  "icon": "./icon.svg",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <1.0.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
